<Project>
  <ItemGroup Condition="'$(XmaxNativeDir)' != '' and '$(MSBuildProjectName)' != 'DotNetSmoke' and '$(MSBuildProjectName)' != 'XmaxSDK.WinUI' and '$(MSBuildProjectName)' != 'XLabShared'">
    <Content Include="$(XmaxNativeDir)/models/**/*" Link="models/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false">
      <Pack Condition="'$(MSBuildProjectName)' == 'XmaxSDK.Net'">true</Pack>
      <PackagePath Condition="'$(MSBuildProjectName)' == 'XmaxSDK.Net'">contentFiles/any/any/models/</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <PackageFlatten>false</PackageFlatten>
    </Content>
    <Content Include="$(XmaxNativeDir)/Xmax.VideoBeautyWorker.exe" Link="Xmax.VideoBeautyWorker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" Condition="Exists('$(XmaxNativeDir)/Xmax.VideoBeautyWorker.exe')">
      <Pack Condition="'$(MSBuildProjectName)' == 'XmaxSDK.Net'">true</Pack>
      <PackagePath Condition="'$(MSBuildProjectName)' == 'XmaxSDK.Net'">runtimes/win-x64/native/</PackagePath>
    </Content>
    <Content Include="$(XmaxNativeDir)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false">
      <Pack Condition="'$(MSBuildProjectName)' == 'XmaxSDK.Net'">true</Pack>
      <PackagePath Condition="'$(MSBuildProjectName)' == 'XmaxSDK.Net'">runtimes/win-x64/native/</PackagePath>
    </Content>
  </ItemGroup>
</Project>
