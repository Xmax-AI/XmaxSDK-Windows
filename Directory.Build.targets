<Project>
  <ItemGroup Condition="'$(XmaxNativeDir)' != '' and '$(MSBuildProjectName)' != 'DotNetSmoke' and '$(MSBuildProjectName)' != 'XmaxSDK.WinUI' and '$(MSBuildProjectName)' != 'XLabShared'">
    <Content Include="$(XmaxNativeDir)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false">
      <Pack Condition="'$(MSBuildProjectName)' == 'XmaxSDK.Net'">true</Pack>
      <PackagePath Condition="'$(MSBuildProjectName)' == 'XmaxSDK.Net'">runtimes/win-x64/native/</PackagePath>
    </Content>
  </ItemGroup>
</Project>
