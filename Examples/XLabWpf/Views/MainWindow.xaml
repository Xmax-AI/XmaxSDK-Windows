<Window x:Class="XLabWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:XLabWpf.Controls"
        xmlns:sdk="clr-namespace:Xmax.SDK.Wpf;assembly=Xmax.SDK.Wpf"
        Title="XLab - WPF" Width="1360" Height="890" MinWidth="1180" MinHeight="800"
        Background="White" Foreground="#111318" FontFamily="{StaticResource UiFont}" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid x:Name="Root">
    <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" SizeChanged="PageSizeChanged" ScrollChanged="PageScrolled">
      <Canvas x:Name="Page" Background="White">
        <Grid x:Name="Header" Height="60" Canvas.Left="28">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="BrandLogo" Source="/Assets/xmax-wordmark.png" Height="35" Width="112.33" Stretch="Uniform" AutomationProperties.Name="Xmax"/>
            <c:Pill Text="UI Preview · camera off" Accent="True" Margin="16,0,0,0" IsHitTestVisible="False" Visibility="{Binding IsPreview, Converter={StaticResource Visible}}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding Active, Converter={StaticResource HiddenWhenTrue}}">
            <c:Pill x:Name="CameraButton" Style="{StaticResource CameraPicker}" Text="{Binding SelectedCamera.Name, TargetNullValue=Select Camera}" ToolTip="{Binding SelectedCamera.Name}" AutomationProperties.Name="Select Camera" IsEnabled="{Binding CanEdit}" IsEnabledChanged="CameraEnabledChanged" Click="CameraClicked" Visibility="{Binding IsPreview, Converter={StaticResource HiddenWhenTrue}}"/>
            <c:Pill x:Name="ModelButton" Text="X2.1" Glyph="chevron" TrailingGlyph="True" Margin="12,0,0,0" IsEnabled="{Binding CanEdit}" Click="ModelClicked"/>
            <c:Pill x:Name="KeyButton" Text="{Binding KeyLabel}" LabelVerticalOffset="4" Glyph="key" ToolTip="API Key" AutomationProperties.Name="API Key" Margin="12,0,0,0" IsEnabled="{Binding CanEdit}" Click="KeyClicked"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding Active, Converter={StaticResource Visible}}">
            <c:Pill Text="X2.1" Foreground="#6B7380" IsHitTestVisible="False"/>
            <c:Pill x:Name="StatisticsButton" Glyph="statistics" Accent="{Binding StatisticsVisible}" ToolTip="Show / hide statistics" Margin="12,0,0,0" Click="StatisticsClicked"/>
            <c:Pill x:Name="VolumeButton" Glyph="{Binding VolumeGlyph}" ToolTip="Remote volume" Margin="12,0,0,0" Click="VolumeClicked">
              <c:Pill.Style><Style TargetType="c:Pill" BasedOn="{StaticResource {x:Type c:Pill}}">
                <Setter Property="Foreground" Value="#8B919D"/>
                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#111318"/></Trigger></Style.Triggers>
              </Style></c:Pill.Style>
            </c:Pill>
            <c:Pill Text="{Binding Elapsed}" Foreground="#6B7380" IsHitTestVisible="False" MinWidth="72" Margin="12,0,0,0"/>
            <c:Pill Text="Record" Glyph="record" Foreground="#8B919D" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="WPF recording is not available in this build." Margin="12,0,0,0"/>
            <c:Pill Text="{Binding StopLabel}" Glyph="stop" Destructive="True" Margin="12,0,0,0" Click="StopClicked"/>
          </StackPanel>
        </Grid>

        <StackPanel x:Name="Landing" c:PageEntry.Enabled="True" Visibility="{Binding Active, Converter={StaticResource HiddenWhenTrue}}">
          <TextBlock x:Name="LandingTitle" Text="Reimagining Live Video with Xmax" FontSize="31.6" FontWeight="Normal" HorizontalAlignment="Center"/>
          <Grid x:Name="LandingStage" Margin="0,24,0,0" HorizontalAlignment="Center">
            <c:CheckerboardSurface/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <c:Pill x:Name="StartButton" Primary="True" Glyph="camera" Text="{Binding StartLabel}" Command="{Binding StartCommand}" HorizontalAlignment="Center"/>
              <CheckBox x:Name="MicrophoneToggle" IsChecked="{Binding Microphone}" Foreground="White" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Center" Margin="0,20,0,0" Cursor="Hand">
                <CheckBox.Template>
                  <ControlTemplate TargetType="CheckBox">
                    <Border Background="#47000000" BorderBrush="#29FFFFFF" BorderThickness="1" CornerRadius="16" Width="158" Height="32">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <c:Glyph Kind="microphone" Width="14" Height="14" Foreground="#8CFFFFFF" Margin="0,0,8,0"/>
                        <TextBlock Text="Microphone" FontSize="13" Foreground="#8CFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border x:Name="Track" Width="30" Height="18" CornerRadius="9" Background="#2EFFFFFF"><Ellipse x:Name="Knob" Fill="White" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0"/></Border>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#2F46E2"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate>
                </CheckBox.Template>
              </CheckBox>
            </StackPanel>
            <TextBlock x:Name="LandingTerms" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,28" FontSize="13" Foreground="#9CA3AF" TextAlignment="Center" TextWrapping="Wrap">
              <Run Text="By clicking Start, you agree to our "/><Hyperlink Foreground="#C3C6CC" NavigateUri="https://platform.xmaxai.com/docs/resources/terms" RequestNavigate="Navigate">Terms of Use</Hyperlink><Run Text=" and "/><Hyperlink Foreground="#C3C6CC" NavigateUri="https://platform.xmaxai.com/docs/resources/privacy" RequestNavigate="Navigate">Privacy Policy</Hyperlink><Run Text="."/>
            </TextBlock>
          </Grid>
          <TextBlock Text="Copyright © 2026 XMAX.AI PTE.LTD. All rights reserved." FontSize="13" Foreground="#6B7380" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>

        <StackPanel x:Name="Workspace" c:PageEntry.Enabled="True" Canvas.Left="28" Visibility="{Binding Active, Converter={StaticResource Visible}}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid x:Name="LocalPanel" c:RoundedClip.Radius="24" Background="Black">
              <sdk:XmaxVideoView x:Name="LocalView" VideoSource="{Binding LocalVideo}" ContentMode="Fill"/>
              <TextBlock Text="{Binding LocalPlaceholder}" Foreground="#B3FFFFFF" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="24,0"/><Style.Triggers><DataTrigger Binding="{Binding StatisticsVisible}" Value="True"><Setter Property="Margin" Value="280,0,24,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <StackPanel Margin="14" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="{Binding StatisticsVisible, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource MetricBox}"><ItemsControl ItemsSource="{Binding TimingRows}" ItemTemplate="{StaticResource MetricRowTemplate}"/></Border>
                <Border Style="{StaticResource MetricBox}"><ItemsControl ItemsSource="{Binding UplinkRows}" ItemTemplate="{StaticResource MetricRowTemplate}"/></Border>
                <Border Style="{StaticResource MetricBox}"><ItemsControl ItemsSource="{Binding UplinkNetworkRows}" ItemTemplate="{StaticResource MetricRowTemplate}"/></Border>
              </StackPanel>
              <Border Background="#59000000" CornerRadius="8" Padding="8,4" Margin="14,0,14,12" VerticalAlignment="Bottom" HorizontalAlignment="Left"><TextBlock Text="{Binding LocalTitle}" Foreground="#A6FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="12" TextTrimming="CharacterEllipsis"/></Border>
            </Grid>
            <Grid x:Name="RemotePanel" Grid.Column="2" c:RoundedClip.Radius="24" Background="Black">
              <sdk:XmaxVideoView x:Name="RemoteView" VideoSource="{Binding RemoteVideo}" ContentMode="Fit"/>
              <TextBlock Text="{Binding ResultPlaceholder}" Foreground="#B3FFFFFF" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="24,0"/><Style.Triggers><DataTrigger Binding="{Binding StatisticsVisible}" Value="True"><Setter Property="Margin" Value="280,0,24,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <StackPanel Margin="14" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="{Binding StatisticsVisible, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource MetricBox}"><ItemsControl ItemsSource="{Binding DownlinkRows}" ItemTemplate="{StaticResource MetricRowTemplate}"/></Border>
                <Border Style="{StaticResource MetricBox}"><ItemsControl ItemsSource="{Binding DownlinkNetworkRows}" ItemTemplate="{StaticResource MetricRowTemplate}"/></Border>
              </StackPanel>
              <TextBlock Text="✦ Xmax" Foreground="#CCFFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"/>
              <Border Background="#59000000" CornerRadius="8" Padding="8,4" Margin="14,0,14,12" VerticalAlignment="Bottom" HorizontalAlignment="Left"><TextBlock Text="Result" Foreground="#A6FFFFFF" FontSize="12"/></Border>
            </Grid>
          </Grid>
          <Border HorizontalAlignment="Center" CornerRadius="21" Background="#1A787880" Height="42" Padding="4" Margin="0,34,0,28">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource ModeTab}" GroupName="Modes" Content="Character Swap" IsChecked="{Binding SelectedMode, Converter={StaticResource ModeChecked}, ConverterParameter=charx}"/>
              <RadioButton Style="{StaticResource ModeTab}" GroupName="Modes" Content="Virtual Try-On" IsChecked="{Binding SelectedMode, Converter={StaticResource ModeChecked}, ConverterParameter=clothx}"/>
              <RadioButton Style="{StaticResource ModeTab}" GroupName="Modes" Content="Style Transfer" IsChecked="{Binding SelectedMode, Converter={StaticResource ModeChecked}, ConverterParameter=vibex}"/>
              <RadioButton Style="{StaticResource ModeTab}" GroupName="Modes" Content="Free Prompt" IsChecked="{Binding SelectedMode, Converter={StaticResource ModeChecked}, ConverterParameter=free}"/>
            </StackPanel>
          </Border>
          <Grid Height="190">
            <ScrollViewer x:Name="CharacterScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedMode, Converter={StaticResource ModeVisible}, ConverterParameter=charx}">
              <ItemsControl ItemsSource="{Binding CharacterReferences}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CenteredWrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><c:ReferenceTile Click="ReferenceClicked"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedMode, Converter={StaticResource ModeVisible}, ConverterParameter=clothx}">
              <ItemsControl ItemsSource="{Binding ClothingReferences}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CenteredWrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><c:ReferenceTile Click="ReferenceClicked"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedMode, Converter={StaticResource ModeVisible}, ConverterParameter=vibex}">
              <ItemsControl ItemsSource="{Binding StyleReferences}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CenteredWrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><c:ReferenceTile Click="ReferenceClicked"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <Border x:Name="FreePromptBox" Height="136" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="18" Background="#F7F8FA" BorderBrush="#E5E7EB" BorderThickness="1" Visibility="{Binding SelectedMode, Converter={StaticResource ModeVisible}, ConverterParameter=free}">
              <Grid Margin="12">
                <TextBox x:Name="PromptEditor" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,112,0"/>
                <TextBlock Text="Describe what you want to see…" Foreground="#9CA3AF" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PromptEditor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <c:Pill Glyph="plus" Width="44" Height="44" Padding="0" Margin="0,0,10,0" ToolTip="Upload reference image" Click="UploadClicked" Visibility="{Binding HasFreeReference, Converter={StaticResource HiddenWhenTrue}}"/>
                  <Grid Width="44" Height="44" Margin="0,0,10,0" Visibility="{Binding HasFreeReference, Converter={StaticResource Visible}}">
                    <Button Style="{StaticResource LinkButton}" Click="FreeReferenceClicked" ToolTip="Select reference / retry upload">
                      <Grid>
                        <Ellipse Width="44" Height="44" Fill="#E5E7EB"/>
                        <Ellipse Width="44" Height="44"><Ellipse.Fill><ImageBrush ImageSource="{Binding FreeReference.Thumbnail}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                        <Border CornerRadius="22" Background="#99000000" Visibility="{Binding FreeReference.IsUploading, Converter={StaticResource Visible}}"><TextBlock Text="Uploading…" FontSize="8" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                        <Border CornerRadius="22" Background="#99000000" Visibility="{Binding FreeReference.HasError, Converter={StaticResource Visible}}"><TextBlock Text="Retry" FontSize="10" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                      </Grid>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0" Click="RemoveFreeReferenceClicked" ToolTip="Remove reference" AutomationProperties.Name="Remove reference">
                      <Border Background="White" CornerRadius="9" BorderBrush="#E5E7EB" BorderThickness="1" Width="18" Height="18"><c:Glyph Kind="close" Width="11" Height="11" Foreground="#6B7380"/></Border>
                    </Button>
                  </Grid>
                  <c:Pill Glyph="arrow" Primary="True" ShowsShadow="False" Width="44" Height="44" Padding="0" ToolTip="Submit prompt" Command="{Binding SubmitPromptCommand}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </StackPanel>

        <DockPanel x:Name="Footer" c:PageEntry.Enabled="True" Height="36" Canvas.Left="28" Visibility="{Binding Active, Converter={StaticResource HiddenWhenTrue}}">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Style="{StaticResource LinkButton}" Width="24" Margin="0,0,18,0" ToolTip="WeChat" Click="WechatClicked"><c:Glyph Kind="wechat" Width="20" Height="20" Foreground="#6B7380"/></Button>
            <Button Style="{StaticResource LinkButton}" Width="24" Margin="0,0,18,0" ToolTip="X" Tag="https://x.com/XmaxAIOfficial" Click="ExternalClicked"><c:Glyph Kind="socialX" Width="18" Height="18" Foreground="#6B7380"/></Button>
            <Button Style="{StaticResource LinkButton}" Width="24" ToolTip="Website" Tag="https://www.xmaxai.com" Click="ExternalClicked"><c:Glyph Kind="globe" Width="20" Height="20" Foreground="#6B7380"/></Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource LinkButton}" Content="Contact Us" Tag="mailto:contact@xmax.ai" Click="ExternalClicked" Margin="0,0,24,0"/>
            <Button Style="{StaticResource LinkButton}" Content="GitHub" Tag="https://github.com/Xmax-AI/XmaxSDK-Windows" Click="ExternalClicked" Margin="0,0,24,0"/>
            <Button Style="{StaticResource LinkButton}" Content="API Platform" Tag="https://platform.xmaxai.com" Click="ExternalClicked"/>
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="PreviewFooter" Text="UI preview · no camera, network session or generated output" Foreground="#9CA3AF" FontSize="11" TextAlignment="Center" Visibility="{Binding IsPreview, Converter={StaticResource Visible}}"/>
      </Canvas>
    </ScrollViewer>

    <Border x:Name="ErrorToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="28,90,28,0" MaxWidth="600" CornerRadius="14" BorderBrush="#14111318" BorderThickness="1" Background="#F5FFFFFF" Padding="14">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><c:Glyph Kind="warning" Width="18" Height="18" Foreground="#E5484D"/><TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" Margin="8,0,12,0"/><Button Grid.Column="2" Style="{StaticResource LinkButton}" Click="DismissError"><c:Glyph Kind="close" Width="18" Height="18" Foreground="#6B7380"/></Button></Grid>
    </Border>

    <Popup x:Name="CameraPopup" PlacementTarget="{Binding ElementName=CameraButton}" Opened="CameraOpened">
      <Border Style="{StaticResource PopupSurface}" Width="276" Padding="7"><StackPanel>
        <ListBox x:Name="CameraList" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera, Mode=OneWay}" ItemContainerStyle="{StaticResource CameraOption}" BorderThickness="0" Padding="0" Background="Transparent" MaxHeight="288" PreviewMouseLeftButtonUp="CameraOptionClicked" PreviewKeyDown="CameraOptionKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
        </ListBox>
        <TextBlock Text="No cameras found" Foreground="#6B7380" FontFamily="Microsoft YaHei UI" FontSize="12" Height="36" Padding="8,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Cameras.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel></Border>
    </Popup>
    <Popup x:Name="ModelPopup" PlacementTarget="{Binding ElementName=ModelButton}">
      <Border Style="{StaticResource PopupSurface}" Width="240" Padding="7">
        <Button Style="{StaticResource LinkButton}" Height="36" Foreground="#2F46E2" Click="ModelSelected" HorizontalContentAlignment="Stretch"><Border Background="#EEF1FF" CornerRadius="8" Width="224" Height="36" Padding="10,0"><Grid><TextBlock Text="X2.1" VerticalAlignment="Center"/><TextBlock Text="✓" FontFamily="Segoe UI Symbol" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></Button>
      </Border>
    </Popup>
    <Popup x:Name="KeyPopup" PlacementTarget="{Binding ElementName=KeyButton}" Opened="KeyOpened">
      <Border Style="{StaticResource PopupSurface}" MinWidth="316" Padding="16"><StackPanel>
        <Grid>
          <TextBox x:Name="ApiKeyInput" TextChanged="ApiKeyChanged" PreviewKeyDown="ApiKeyKeyDown" ToolTip="API Key" AutomationProperties.Name="API Key input"/>
          <TextBlock Text="API Key" Foreground="#9CA3AF" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ApiKey.Length}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <TextBlock Foreground="#6B7380" FontSize="12" Margin="2,12,2,0">
          <Run Text="Get an API key from the "/><Hyperlink Foreground="#2F46E2" NavigateUri="https://platform.xmaxsi.com/api-keys" RequestNavigate="Navigate">Xmax Open Platform</Hyperlink><Run Text="."/>
        </TextBlock>
      </StackPanel></Border>
    </Popup>
    <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}">
      <Border Style="{StaticResource PopupSurface}" Width="240" Padding="14"><StackPanel><TextBlock Text="{Binding VolumeLabel}" FontSize="12" Margin="0,0,0,10"/><Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Border>
    </Popup>
    <Popup x:Name="WechatPopup" Placement="Center" PlacementTarget="{Binding ElementName=Root}">
      <Border Style="{StaticResource PopupSurface}" Padding="14"><StackPanel><Image x:Name="WechatImage" Width="180" Height="180"/><TextBlock Text="Follow us on WeChat" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
    </Popup>
  </Grid>
</Window>
