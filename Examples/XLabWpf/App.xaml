<Application x:Class="XLabWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:XLabWpf.Controls">
  <Application.Resources>
    <FontFamily x:Key="UiFont">/XLabWpf;component/Assets/#DM Sans</FontFamily>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <c:FalseVisibleConverter x:Key="HiddenWhenTrue" />
    <c:ModeVisibleConverter x:Key="ModeVisible" />
    <c:ModeCheckedConverter x:Key="ModeChecked" />
    <c:CapsuleRadiusConverter x:Key="CapsuleRadius" />
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#111318"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>
    <Style TargetType="c:Pill">
      <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="36"/>
      <Setter Property="Padding" Value="15,0"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="Foreground" Value="#111318"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="#E2E5EA"/>
      <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="White"/><GradientStop Color="#F3F4F6" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="c:Pill">
            <Border x:Name="Surface" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:Glyph x:Name="Icon" Kind="{TemplateBinding Glyph}" Foreground="{TemplateBinding Foreground}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Label" Grid.Column="1" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"><TextBlock.RenderTransform><TranslateTransform Y="{Binding LabelVerticalOffset, RelativeSource={RelativeSource TemplatedParent}}"/></TextBlock.RenderTransform></TextBlock>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Glyph" Value=""><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/></Trigger>
              <Trigger Property="Text" Value=""><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/><Setter TargetName="Icon" Property="Margin" Value="0"/></Trigger>
              <Trigger Property="TrailingGlyph" Value="True"><Setter TargetName="Icon" Property="Grid.Column" Value="2"/><Setter TargetName="Icon" Property="Margin" Value="8,0,0,0"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C9CED6"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2F46E2"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="Primary" Value="True"><Setter TargetName="Icon" Property="Width" Value="20"/><Setter TargetName="Icon" Property="Height" Value="20"/><Setter TargetName="Surface" Property="Effect"><Setter.Value><DropShadowEffect Color="#2F46E2" BlurRadius="16" ShadowDepth="7" Opacity="0.24"/></Setter.Value></Setter></Trigger>
              <Trigger Property="ShowsShadow" Value="False"><Setter TargetName="Surface" Property="Effect" Value="{x:Null}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Accent" Value="True"><Setter Property="Background" Value="#EEF1FF"/><Setter Property="Foreground" Value="#2F46E2"/><Setter Property="BorderBrush" Value="#D7DDFB"/></Trigger>
        <Trigger Property="Primary" Value="True"><Setter Property="Height" Value="52"/><Setter Property="Padding" Value="32,0"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#2F46E2"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="Transparent"/></Trigger>
        <Trigger Property="Destructive" Value="True"><Setter Property="Background" Value="#FDF2F2"/><Setter Property="Foreground" Value="#DC2626"/><Setter Property="BorderBrush" Value="#F1BABA"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#111318"/><Setter Property="CaretBrush" Value="#2F46E2"/>
      <Setter Property="SelectionBrush" Value="#CCD4FF"/><Setter Property="Padding" Value="12,9"/>
      <Setter Property="Background" Value="#F7F8FA"/><Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#2F46E2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Popup"><Setter Property="AllowsTransparency" Value="True"/><Setter Property="StaysOpen" Value="False"/><Setter Property="PopupAnimation" Value="Fade"/></Style>
    <Style x:Key="CameraPicker" TargetType="c:Pill" BasedOn="{StaticResource {x:Type c:Pill}}">
      <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="Padding" Value="11,0"/><Setter Property="MaxWidth" Value="218"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="c:Pill">
          <Border x:Name="Surface" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <c:Glyph Kind="camera" Width="16" Height="16" Foreground="#111318" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <c:Glyph Grid.Column="2" Kind="chevron" Width="14" Height="14" Foreground="#111318" Margin="8,0,0,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C9CED6"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2F46E2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="CameraOption" TargetType="ListBoxItem">
      <Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Foreground" Value="#111318"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="ToolTip" Value="{Binding Name}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock x:Name="Check" Grid.Column="1" Text="✓" FontFamily="Segoe UI Symbol" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F3F4F6"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EEF1FF"/><Setter Property="Foreground" Value="#2F46E2"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#C7D0F8"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="PopupSurface" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/></Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="#6B7380"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#111318"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ModeTab" TargetType="RadioButton">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="#6B7380"/><Setter Property="Padding" Value="22,0"/><Setter Property="Height" Value="34"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" CornerRadius="17" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#A6FFFFFF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="White"/><Setter TargetName="Tab" Property="BorderBrush" Value="#0D000000"/><Setter Property="Foreground" Value="#111318"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="c:ReferenceTile">
      <Setter Property="Width" Value="84"/><Setter Property="Height" Value="84"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="{Binding Name}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="IsEnabled" Value="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="c:ReferenceTile">
          <Grid Background="Transparent">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="6"/><RowDefinition Height="14"/></Grid.RowDefinitions>
            <Ellipse x:Name="Outline" Width="64" Height="64" Fill="#F7F8FA" Stroke="#F3F4F6" StrokeThickness="2"/>
            <Ellipse Width="60" Height="60"><Ellipse.Fill><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
            <c:Glyph x:Name="Plus" Kind="plus" Width="22" Height="22" Foreground="#6B7380" Visibility="Collapsed"/>
            <c:Glyph x:Name="Warning" Kind="warning" Width="22" Height="22" Foreground="#6B7380" Visibility="Collapsed"/>
            <TextBlock x:Name="Loading" Text="···" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B7380" Visibility="Collapsed"/>
            <Border Background="#99000000" CornerRadius="32" Width="64" Height="64" Visibility="{Binding IsUploading, Converter={StaticResource Visible}}"><TextBlock Text="Uploading…" Foreground="White" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <TextBlock x:Name="Name" Grid.Row="2" Text="{Binding Name}" TextAlignment="Center" FontSize="11" Foreground="#6B7380" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Stroke" Value="#C7D0F8"/></Trigger>
            <DataTrigger Binding="{Binding IsUpload}" Value="True"><Setter TargetName="Plus" Property="Visibility" Value="Visible"/><Setter TargetName="Outline" Property="StrokeThickness" Value="1"/></DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Outline" Property="Stroke" Value="#2F46E2"/><Setter TargetName="Name" Property="Foreground" Value="#2F46E2"/></DataTrigger>
            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter TargetName="Loading" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter TargetName="Warning" Property="Visibility" Value="Visible"/><Setter Property="ToolTip" Value="{Binding Error}"/></DataTrigger>
            <DataTrigger Binding="{Binding IsUploading}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="MetricRowTemplate">
      <Border x:Name="Row" BorderBrush="#30FFFFFF"><Grid Height="17"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#E6FFFFFF"/><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontFamily="Consolas" Foreground="#E6FFFFFF"/></Grid></Border>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Label}" Value="Total startup"><Setter TargetName="Row" Property="BorderThickness" Value="0,1,0,0"/><Setter TargetName="Row" Property="Padding" Value="0,6,0,0"/><Setter TargetName="Row" Property="Margin" Value="0,4,0,0"/><Setter TargetName="Row" Property="TextBlock.FontWeight" Value="SemiBold"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="MetricBox" TargetType="Border"><Setter Property="Width" Value="250"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="#99000000"/><Setter Property="BorderBrush" Value="#1FFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  </Application.Resources>
</Application>
