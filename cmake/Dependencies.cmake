# Resolve private source dependencies into the build tree, never the source checkout.
set(XMAX_DEPENDENCIES_DIR "${CMAKE_BINARY_DIR}/dependencies" CACHE PATH "Cache for SHA-256-verified SDK dependencies")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../Configurations/Release/dependencies.json" XMAX_DEPENDENCY_LOCK)

function(xmax_download_locked destination url sha256)
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" actual)
    if("${actual}" STREQUAL "${sha256}")
      return()
    endif()
  endif()
  get_filename_component(directory "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  message(STATUS "Fetching locked dependency: ${url}")
  file(DOWNLOAD "${url}" "${destination}.download"
    TLS_VERIFY ON STATUS download_status TIMEOUT 60)
  list(GET download_status 0 result)
  if(NOT result EQUAL 0)
    list(GET download_status 1 reason)
    file(REMOVE "${destination}.download")
    message(FATAL_ERROR "Dependency download failed: ${reason}")
  endif()
  file(SHA256 "${destination}.download" actual)
  if(NOT "${actual}" STREQUAL "${sha256}")
    file(REMOVE "${destination}.download")
    message(FATAL_ERROR "Dependency SHA-256 mismatch: ${url}")
  endif()
  file(RENAME "${destination}.download" "${destination}")
endfunction()

string(JSON XMAX_JSON_VERSION GET "${XMAX_DEPENDENCY_LOCK}" nlohmann version)
set(XMAX_JSON_INCLUDE_DIR "${XMAX_DEPENDENCIES_DIR}/nlohmann-${XMAX_JSON_VERSION}/include")
set(XMAX_JSON_LICENSE_FILE "${XMAX_DEPENDENCIES_DIR}/nlohmann-${XMAX_JSON_VERSION}/LICENSE.MIT")
foreach(asset IN ITEMS header license)
  string(JSON url GET "${XMAX_DEPENDENCY_LOCK}" nlohmann ${asset} url)
  string(JSON sha256 GET "${XMAX_DEPENDENCY_LOCK}" nlohmann ${asset} sha256)
  if(asset STREQUAL "header")
    set(destination "${XMAX_JSON_INCLUDE_DIR}/nlohmann/json.hpp")
  else()
    set(destination "${XMAX_JSON_LICENSE_FILE}")
  endif()
  xmax_download_locked("${destination}" "${url}" "${sha256}")
endforeach()
