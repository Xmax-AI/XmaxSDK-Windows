cmake_minimum_required(VERSION 3.24)
# Enforce the same direction as the module target graph, including header-only dependencies.
set(layers Foundation Service Stream Media Render Core CAPI)
set(allowed_Foundation Foundation)
set(allowed_Service Service Foundation)
set(allowed_Stream Stream Service Foundation)
set(allowed_Media Media Service Foundation)
set(allowed_Render Render Service Foundation)
set(allowed_Core Core Service Stream Media Render Foundation)
set(allowed_CAPI CAPI Core Service Foundation)
foreach(layer IN LISTS layers)
  file(GLOB_RECURSE files "${XMAX_SRC}/${layer}/*.hpp" "${XMAX_SRC}/${layer}/*.cpp" "${XMAX_SRC}/${layer}/*.mm")
  foreach(source IN LISTS files)
    file(STRINGS "${source}" includes REGEX "^[ \t]*#include")
    foreach(line IN LISTS includes)
      if(line MATCHES "#include[ \t]*[\"<](Q[A-Z]|Qt|q[a-z])")
        message(FATAL_ERROR "SDK must not depend on Qt: ${source}: ${line}")
      endif()
      if(line MATCHES "#include[ \t]*[\"<]([A-Za-z]+)/")
        set(dependency "${CMAKE_MATCH_1}")
        if(dependency IN_LIST layers AND NOT dependency IN_LIST allowed_${layer})
          message(FATAL_ERROR "Layer violation: ${source} includes ${dependency}. Allowed: ${allowed_${layer}}")
        endif()
      elseif(line MATCHES "#include[ \t]*\"\\.\\./")
        message(FATAL_ERROR "Use explicit layer paths in ${source}: ${line}")
      endif()
    endforeach()
  endforeach()
endforeach()
# Examples consume only the installed public API; no shortcut to internal module headers.
file(GLOB_RECURSE example_sources "${XMAX_SRC}/../../Examples/*.cpp" "${XMAX_SRC}/../../Examples/*.hpp")
foreach(source IN LISTS example_sources)
  file(STRINGS "${source}" includes REGEX "^[ \t]*#include")
  foreach(line IN LISTS includes)
    if(line MATCHES "#include[ \t]*[\"<]([A-Za-z]+)/")
      if(CMAKE_MATCH_1 IN_LIST layers)
        message(FATAL_ERROR "Example must use the public C/C++ API: ${source}: ${line}")
      endif()
    endif()
  endforeach()
endforeach()
