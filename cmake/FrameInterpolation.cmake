if(NOT EXISTS "${XMAX_RIFE_SOURCE_DIR}/src/ncnn/CMakeLists.txt")
  message(FATAL_ERROR "Set XMAX_RIFE_SOURCE_DIR to the locked rife-ncnn-vulkan source tree with its ncnn/glslang submodules.")
endif()
find_package(Vulkan REQUIRED)
find_package(Threads REQUIRED)
# The pinned upstream build files declare CMake 2.8 compatibility. CMake 4
# removed those policies; keep the dependency on its supported modern policy floor.
if(CMAKE_VERSION VERSION_GREATER_EQUAL 4.0)
  set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
endif()
set(NCNN_VERSION 20220728)
set(NCNN_VULKAN ON CACHE BOOL "" FORCE)
set(NCNN_VULKAN_ONLINE_SPIRV ON CACHE BOOL "" FORCE)
set(NCNN_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(NCNN_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(NCNN_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(NCNN_BUILD_BENCHMARK OFF CACHE BOOL "" FORCE)
set(NCNN_INSTALL_SDK OFF CACHE BOOL "" FORCE)
add_subdirectory("${XMAX_RIFE_SOURCE_DIR}/src/ncnn" "${CMAKE_BINARY_DIR}/ncnn" EXCLUDE_FROM_ALL)

set(rife_src "${XMAX_RIFE_SOURCE_DIR}/src")
file(GLOB rife_shaders CONFIGURE_DEPENDS "${rife_src}/*.comp")
set(shader_headers)
foreach(shader IN LISTS rife_shaders)
  get_filename_component(shader_name "${shader}" NAME_WE)
  set(header "${CMAKE_CURRENT_BINARY_DIR}/rife-shaders/${shader_name}.comp.hex.h")
  add_custom_command(OUTPUT "${header}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/rife-shaders"
    COMMAND "${CMAKE_COMMAND}" "-DSHADER_SRC=${shader}" "-DSHADER_COMP_HEADER=${header}"
      -P "${rife_src}/generate_shader_comp_header.cmake"
    DEPENDS "${shader}" "${rife_src}/generate_shader_comp_header.cmake" VERBATIM)
  list(APPEND shader_headers "${header}")
endforeach()
add_library(xmax_rife STATIC "${rife_src}/rife.cpp" "${rife_src}/warp.cpp" ${shader_headers})
target_include_directories(xmax_rife PUBLIC "${rife_src}" PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/rife-shaders")
target_link_libraries(xmax_rife PUBLIC ncnn Vulkan::Vulkan Threads::Threads)
if(MSVC)
  target_compile_options(xmax_rife PRIVATE /utf-8)
endif()

set_target_properties(xmax_rife PROPERTIES CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../Configurations/Release/dependencies.json" lock)
string(JSON model GET "${lock}" rife model)
foreach(name IN ITEMS flownet.param flownet.bin)
  set(asset "${XMAX_RIFE_SOURCE_DIR}/models/${model}/${name}")
  if(NOT EXISTS "${asset}")
    message(FATAL_ERROR "RIFE model file missing: ${asset}")
  endif()
  file(SHA256 "${asset}" actual)
  string(JSON expected GET "${lock}" rife models "${name}")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "RIFE model SHA-256 mismatch: ${name}")
  endif()
endforeach()
include(GNUInstallDirs)
if(WIN32)
  set(model_runtime_directory "${CMAKE_INSTALL_BINDIR}")
else()
  set(model_runtime_directory "${CMAKE_INSTALL_LIBDIR}")
endif()
install(DIRECTORY "${XMAX_RIFE_SOURCE_DIR}/models/${model}/" DESTINATION ${model_runtime_directory}/models/${model})
install(FILES "${XMAX_RIFE_SOURCE_DIR}/LICENSE" DESTINATION licenses/rife)
install(FILES "${XMAX_RIFE_SOURCE_DIR}/src/ncnn/LICENSE.txt" DESTINATION licenses/ncnn)
install(FILES "${XMAX_RIFE_SOURCE_DIR}/src/ncnn/glslang/LICENSE.txt" DESTINATION licenses/glslang)
